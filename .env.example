# Copia questo file in .env e inserisci la tua chiave API.
# Il file .env non va mai condiviso né caricato su GitHub (è già escluso da .gitignore).

# Obbligatoria: chiave API di Anthropic (https://console.anthropic.com/ → API Keys)
ANTHROPIC_API_KEY=

# Modello Claude (predefinito: claude-opus-5-5). Alternative più economiche: claude-sonnet-5-5
CLAUDE_MODEL=claude-opus-5-5
# Livello di ragionamento: low | medium | high | xhigh | max (più alto = più accurato e più costoso)
CLAUDE_EFFORT=high
# Se il modello rifiuta una richiesta, l'API la ripete su un modello alternativo (true/false)
CLAUDE_REFUSAL_FALLBACK=true
# Lunghezza massima di ogni risposta in token (comprende il ragionamento interno del modello)
CLAUDE_MAX_OUTPUT_TOKENS=120000

# Server locale (127.0.0.1 = raggiungibile solo da questo computer)
HOST=127.0.0.1
PORT=8000
# Dimensione massima dei file caricati (su Vercel il limite effettivo è 4 MB per richiesta)
MAX_UPLOAD_MB=30

# Testi oltre questa soglia (caratteri) vengono analizzati per segmenti e poi uniti.
# Valori pensati perché ogni passo resti entro i 300 secondi di una funzione Vercel.
SINGLE_PASS_MAX_CHARS=30000
SEGMENT_MAX_CHARS=25000
# Argomenti per ciascuna parte della lezione completa (le lezioni lunghe sono scritte a parti)
LESSON_PART_TOPICS=4
# Oltre questa soglia la lezione viene scritta dall'inventario senza allegare la fonte integrale
LESSON_SOURCE_MAX_CHARS=600000
# Richieste in parallelo verso l'API
PARALLEL_REQUESTS=3
# Mostra nella lezione completa i riferimenti ai passaggi della trascrizione (Rif. fonte: T012...)
SHOW_SOURCE_REFS=true

# Verifica web (facoltativa, attivabile dall'interfaccia)
WEB_SEARCH_TOOL=web_search_20260209
WEB_FETCH_TOOL=web_fetch_20260209
WEB_SEARCH_MAX_USES=8

# Prezzi per la stima dei costi (USD per milione di token); vuoti = valori noti del modello
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# --- Uso online -------------------------------------------------------------
# Su Vercel, su Render o con HOST diverso da 127.0.0.1 l'app è considerata online e
# RICHIEDE una password: senza APP_PASSWORD risponde solo con un messaggio di configurazione.
APP_PASSWORD=
# Chiave per firmare i cookie di sessione (stringa casuale lunga). Vuota = derivata da password e chiave API.
SESSION_SECRET=
# Durata dell'accesso in ore
SESSION_HOURS=12
